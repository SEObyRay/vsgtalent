{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/wp-content/:path*",
      "destination": "https://wordpress-474222-5959679.cloudwaysapps.com/wp-content/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/nieuws/2025/glorieuze-overwinning-iame-x30-challenge",
      "destination": "/nieuws/2025/levy-opbergen-p5-rookiepodium-strijen-2025",
      "permanent": true
    },
    {
      "source": "/nieuws/2026/levy-opbergen-schittert-podiumplaats-strijen",
      "destination": "/nieuws/2025/levy-opbergen-p5-rookiepodium-strijen-2025",
      "permanent": true
    },
    {
      "source": "/nieuws/2026/levy-opbergen-vernieuwd-circuit-emmen",
      "destination": "/nieuws/2026/levy-opbergen-nk4t-debuut-landsard-2026",
      "permanent": true
    },
    {
      "source": "/nieuws/2026/levy-opbergen-zet-volgende-stap-in-2025-chrono-nk-4t-en-nxt-gp-dutch-open",
      "destination": "/nieuws/2026/levy-opbergen-chrono-nk4t-nxt-gp-2026",
      "permanent": true
    }
  ]
}
